<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PocketGpt" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.PocketGpt" parent="Base.Theme.PocketGpt" />

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <!-- The icon to display -->
        <!-- <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item> -->
        <!-- Point back to the main app theme once finished -->
        <item name="postSplashScreenTheme">@style/Theme.PocketGpt</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <!-- Sharp Shape for NavigationView -->
    <style name="ShapeAppearanceOverlay.App.Sharp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>
</resources>